<!DOCTYPE html>
<html>
  <head>
	  <!-- Google tag (gtag.js) -->
	  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0F487C8SWX"></script>
	  <script>
	    window.dataLayer = window.dataLayer || [];
	    function gtag(){dataLayer.push(arguments);}
	    gtag('js', new Date());

	    gtag('config', 'G-0F487C8SWX');
	  </script>
    <title><%= content_for(:title) || "CHILLFILTR®" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
	<meta name="description" content="<%= content_for(:description) || 'CHILLFILTR® - Discover the latest content and updates' %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Karla:wght@400;500;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/svg-logo2.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-300v2.png">
	
	<%# add meta tags for socials %>
	<meta property="og:title" content="<%= content_for(:title) %>">

    <%# RSS feed link for auto-discovery %>
    <%= auto_discovery_link_tag(:rss, posts_feed_url(format: :rss), { title: "CHILLFILTR® Latest Posts" }) %>
    
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload", preload: false %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="<%= 'collapse' if controller_name == 'home' && action_name == 'index' %>" class="font-sans bg-air text-ink">

	<%= render "shared/app_layout_menu" %>
	<%= render 'shared/flash' %>

    <main class="flex justify-center min-h-screen">
      <div class="w-full max-w-screen-lg px-4">
        <%= yield %>
      </div>

    </main>

	<footer class="border-t border-line mt-16">
	  <div class="container px-5 py-10 mx-auto flex items-center sm:flex-row flex-col gap-4">

	      <a class="flex items-center md:justify-start justify-center text-ink" href="/">
	        <%= render 'shared/logo30' %>
	        <span class="ml-3 font-display italic text-xl tracking-tight">CHILLFILTR®</span>
	      </a>
	      <p class="text-sm text-muted sm:ml-4 sm:pl-4 sm:border-l sm:border-line sm:mt-0 mt-2">©<%= Time.zone.now.year %>
	        <a href="https://blacklake.media" class="text-muted ml-1 hover:text-moss" rel="noopener noreferrer" target="_blank">Black Lake Media</a>
	      </p>
	      <p class="text-sm text-muted sm:ml-4 sm:pl-4 sm:border-l sm:border-line sm:mt-0 mt-2">
	        <a href="#" class="text-muted ml-1 hover:text-moss" rel="noopener noreferrer" target="_blank" aria-label="send your song to CHILLFILTR®"><%= link_to "Submissions", pages_submit_path, class: "text-sm" %></a>
	      </p>
	      <p class="text-sm text-muted sm:ml-4 sm:pl-4 sm:border-l sm:border-line sm:mt-0 mt-2">
	        <a href="#" class="text-muted ml-1 hover:text-moss" rel="noopener noreferrer" target="_blank" aria-label="contact CHILLFILTR®"><%= link_to "Contact", pages_contact_path, class: "text-sm" %></a>
	      </p>

	    <span class="inline-flex sm:ml-auto sm:mt-0 mt-2 justify-center sm:justify-start gap-3">
	      <a class="text-muted hover:text-moss" href="https://www.facebook.com/chillfiltr" target="_blank" aria-label="CHILLFILTR® on Facebook">
	        <svg fill="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-5 h-5" viewBox="0 0 24 24">
	          <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path>
	        </svg>
	      </a>
	      <a class="text-muted hover:text-moss" href="https://www.x.com/chillfiltr" target="_blank" aria-label="CHILLFILTR® on X">
	        <svg fill="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-5 h-5" viewBox="0 0 24 24">
	          <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"></path>
	        </svg>
	      </a>
	      <a class="text-muted hover:text-moss" href="https://www.instagram.com/chillfiltr" target="_blank"  aria-label="CHILLFILTR® on Insta">
	        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-5 h-5" viewBox="0 0 24 24">
	          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
	          <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"></path>
	        </svg>
	      </a>
	      <a class="text-muted hover:text-moss"  href="https://www.linkedin.com/company/black-lake-media/" target="_blank"  aria-label="visit Black Lake Media">
	        <svg fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="0" class="w-5 h-5" viewBox="0 0 24 24">
	          <path stroke="none" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path>
	          <circle cx="4" cy="4" r="2" stroke="none"></circle>
	        </svg>
	      </a>
	    </span>
	  </div>
	</footer>

  </body>

</html>
