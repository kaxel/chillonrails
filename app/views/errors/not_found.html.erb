<div class="flex flex-col items-center justify-center min-h-96 text-center font-sans text-ink">
  <div><%= image_tag('error-animation.gif') %></div>
  <h1 class="font-display italic text-6xl text-ink mb-4">404</h1>
  <h2 class="not-italic font-sans font-medium text-2xl text-muted mb-4">Page Not Found</h2>

  <% if @original_path %>
    <p class="text-muted mb-6">
      The page <code class="bg-paper border border-line px-2 py-1 rounded text-sm"><%= @original_path %></code> could not be found.
    </p>
  <% else %>
    <p class="text-muted mb-6">The page you were looking for could not be found.</p>
  <% end %>

  <div class="space-x-4 my-6">
    <%= link_to "Go Home", root_path, class: "px-6 py-3 bg-moss text-white rounded-full hover:bg-moss-dark transition-colors" %>
    <%= link_to "Go Back", "javascript:history.back()", class: "px-6 py-3 border border-line text-ink rounded-full hover:border-moss hover:text-moss transition-colors" %>
  </div>
</div>
