<section data-collapse-target="content" class="font-sans text-ink overflow-hidden transition-all duration-300 ease-in-out">
    <div class="container mx-auto px-5 py-16 max-w-2xl">
      <div class="flex flex-col items-center text-center">
        <p class="text-xs tracking-widest uppercase text-muted mb-4">CHILLFILTR®</p>
        <h1 class="font-display italic text-4xl sm:text-5xl mb-5 text-ink">Supports Indie.</h1>
        <p class="mb-9 leading-relaxed text-muted max-w-md">A platform for independent voices in music and literature. Listen live Wednesday nights, 9&ndash;11pm, on 89.5 FM Ashland and 94.1 FM Medford, at <a class="text-moss hover:underline" href="https://kskq.org" target="_blank">kskq.org</a>, archived at <a class="text-moss hover:underline" href="https://weeklycatch.org" target="_blank">weeklycatch.org</a>.
        </p>
        <div class="flex justify-center items-center gap-3 text-sm">
          <a href="#top_of_index" class="inline-flex text-white bg-moss border-0 py-2 px-6 hover:bg-moss-dark rounded-full transition-colors">Posts</a>
          <%= link_to "Submissions", pages_submit_path, class: "inline-flex text-ink border border-line py-2 px-6 hover:border-moss hover:text-moss rounded-full transition-colors" %>
          <%= link_to posts_feed_path(format: :rss, topic: "music"), target: "_blank", class: "inline-flex items-center text-muted border border-line py-2 px-6 hover:border-moss hover:text-moss rounded-full transition-colors" do %>
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3.429 2.571c0-.952.77-1.714 1.714-1.714s1.714.762 1.714 1.714-.77 1.714-1.714 1.714-1.714-.762-1.714-1.714zm.571 4.286c3.143 0 5.714 2.571 5.714 5.714h2.286c0-4.381-3.619-8-8-8v2.286zm0 4c1.143 0 2.286 1.143 2.286 2.286h2.286c0-2.476-2.095-4.571-4.571-4.571v2.285z"/>
              </svg>
              RSS
          <% end %>
        </div>
      </div>
    </div>

    <!-- Link Letter Opener -->
</section>
<a id="top_of_index"></a>
<!-- FIRST CONTENT SECTION -->
<section class="mb-12">
<p class="text-xs tracking-widest uppercase text-muted mb-4 text-center">Top Posts</p>
<div class="max-w-2xl mx-auto bg-paper rounded-2xl border border-line">
  <%= render "shared/top_posts_list" %>
</div>
</section>
<section>
<h1 class="font-display italic sm:text-4xl text-3xl my-8 mb-6 text-ink text-center">Recent Posts<% if @current_topic %><%= " in #{@current_topic.titleize}" %><% end %></h1>
<!-- SECOND CONTENT SECTION -->
<div id="posts-container" data-controller="infinite-scroll" data-infinite-scroll-page-value="<%= @page %>" data-infinite-scroll-topic-value="<%= @current_topic %>">
  <% @posts.each_slice(2) do |first_p, second_p| %>
    <%= render "shared/index_items", :first_p => first_p, :second_p => second_p %>
  <% end %>
</div>
<div id="loading-indicator" class="text-center py-8">
  <!-- Loading content will be inserted here by JavaScript -->
</div>
</section>
<%= render "shared/more_links" %>