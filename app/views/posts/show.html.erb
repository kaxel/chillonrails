<% content_for :head do %>
  <meta name="description" content="<%= @post.preview %>">
  <meta name="keywords" content="<%= @post.topic %>, <%= @post.tags_from_hash.join(", ") %>, <%= @post.locations_from_hash.join(", ") unless !@post.location %>">
  
  <meta property="og:type" content="article" />
  <meta property="og:description" content="<%= @post.preview %>">
  <meta property="og:image" content="<%= @post.image %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta name="twitter:card" content="summary_large_image">
<% end %>

<header class="post-header font-sans">
  <div class="post-meta flex justify-center">
    <div class="flex flex-wrap justify-center">
	<% if @post.topic.present? %>
	  <%= render "shared/post_topic", :post => @post %>
    <% end %>
    <% if @post.location.present? %>
	  <%= render "shared/post_locations", :post => @post %>
    <% end %>
    <% if @post.tags.present? %>
	  <%= render "shared/post_tags", :post => @post %>
    <% end %>
    </div>
  </div>
  <div class="title-section flex justify-center px-4"><h1 class="font-display italic text-3xl sm:text-4xl text-ink text-center max-w-2xl"><%= @post.title %></h1></div>
  <div class="title-section flex justify-center"><p class="not-italic font-sans text-lg text-muted px-8 max-w-xl text-center mx-auto"><%= @post.preview %></p></div>

  <div class="author-info flex justify-center mt-4">
    <p class="text-sm text-muted">Published <%= @post.published_on %> by <%= pretty_author(@post.author) %></p>
  </div>
</header>

<div class="container px-5 py-2 mx-auto">
  <div class="flex flex-wrap -mx-4 -mb-10 text-center">
    <div class="post-show mb-8">

      <div class="post-content">
        <% if @post.image.present? %>
		  <div class="flex justify-center mb-4">
            <%= render 'shared/responsive_image', 
                       image_url: @post.image, 
                       alt_text: @post.title,
                       css_classes: "featured-image",
                       loading: "eager" %>
		  </div>
        <% end %>

		<% if current_user || true %>
          <% if @post.video_link.present? %>
            <div class="video-section">
			  <% if @post.video_link.include?("vimeo") %>
			    <div style="padding:56.25% 0 0 0;position:relative;"><iframe src="https://player.vimeo.com/video/<%= get_val_string(@post.video_link) %>?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="Richy Mitch &amp; The Coal Miners - Wet Socks (lyric video)"></iframe></div><script src="https://player.vimeo.com/api/player.js"></script>
			  <% elsif @post.video_link.include?("mixcloud") %>
			    <iframe title="Mixcloud player" allow="autoplay" width="100%" height="120" frameborder="0"
			    src="https://www.mixcloud.com/widget/iframe/?hide_cover=1&light=1&feed=<%= ERB::Util.url_encode(URI.parse(@post.video_link).path) %>"></iframe>
			  <% else %>
			    <iframe id="ytplayer" type="text/html" width="100%" height="540"
			    src="https://www.youtube.com/embed/<%= get_val_string(@post.video_link) %>?autoplay=1&origin=http://chillfiltr.com"
			    frameborder="0"></iframe>
			  <% end %>
            </div>
          <% end %>

          <% if @post.audio_link.present? %>
            <div class="audio-section flex justify-center">
			  <audio controls preload="metadata" style="width: 320px; height: 54px; filter: sepia(20%) saturate(70%) grayscale(1) contrast(99%) invert(12%);">
			    <source src="<%= @post.audio_link %>" type="audio/mpeg">
			    Your browser does not support the audio element.
			  </audio>
            </div>
          <% end %>
		<% end %>

        <div class="content text-left">
          <%= sanitize @post.content, tags: %w[p br strong em ul ol li h1 h2 h3 h4 h5 h6 blockquote a img], attributes: %w[href src alt class] %>
        </div>
      </div>

      <div class="post-actions font-sans flex flex-col items-center gap-2 text-sm mt-8">
        <% if Current.user&.admin? %><%= link_to "Edit", edit_post_path(slug: @post.slug), class: "text-moss hover:text-moss-dark" %><% end %>
        <%= link_to "Back to Posts", root_path, class: "text-moss hover:text-moss-dark" %>
		<a href="/posts/<%= @random_link %>" class="text-moss hover:text-moss-dark">Something Random</a>
      </div>
    </div>
  <div>
</div>
