<section class="font-sans text-ink overflow-hidden">
  <div class="container mx-auto px-5 py-12 max-w-4xl">
    <div class="flex flex-col items-center text-center mb-12">
      <h1 class="font-display italic sm:text-4xl text-3xl mb-4 text-ink">
        Browse by Tag
      </h1>
      <p class="text-muted">Click any tag to see all posts with that tag</p>
    </div>

    <div class="bg-paper rounded-2xl border border-line p-6">
      <% if @tags.any? %>
        <div class="flex flex-wrap gap-2">
          <% @tags.each do |tag| %>
            <%= link_to tag_path(tag.slug),
                class: "inline-block px-4 py-2 rounded-full text-sm font-medium transition-colors #{tag.color.present? ? '' : 'bg-air text-muted hover:text-moss'}",
                style: (tag.color.present? ? "background-color: #{tag.color}; color: white;" : nil) do %>
              <%= tag.name.titleize %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-muted">No tags available yet.</p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/more_links" %>
