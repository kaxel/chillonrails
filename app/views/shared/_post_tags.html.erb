	  <% post.tags_from_hash.each do |e| %>
        <div>
			<span class="inline-block px-2 text-xs m-1 py-1 font-medium text-muted <%= get_tag_color(e) %> border border-line rounded-full">
				<% if tag_should_be_capitalized(e) %>
					<%= e.upcase %>
				<% else %>
					<%= e %>
				<% end %>
			</span>
		</div>
	  <% end %>