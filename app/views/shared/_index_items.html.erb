	<section class="font-sans text-ink">
	  <div class="container px-5 py-2 mx-auto">

	    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-14">

		  <!-- post 1 -->
		  <article data-post-id="<%= first_p.id %>">
	        <div class="rounded-2xl h-80 overflow-hidden mb-4">
	          <%= render 'shared/responsive_image',
	                     image_url: first_p.image,
	                     alt_text: first_p.title,
	                     css_classes: "object-cover object-center h-full w-full",
	                     link_url: "/post/#{first_p.slug}" %>
	        </div>
		    <div class="flex items-center gap-2 text-xs tracking-widest uppercase text-muted mb-2">
		      <i class="w-1.5 h-1.5 rounded-full <%= get_topic_color(first_p.topic) %>"></i><%= first_p.topic %>
		    </div>
		    <div class="flex flex-wrap">
		    <% if first_p.location.present? %>
			  <%= render "shared/post_locations", :post => first_p %>
		    <% end %>
		    <% if first_p.tags.present? %>
			  <%= render "shared/post_tags", :post => first_p %>
		    <% end %>
		    </div>
	        <h3 class="mb-2 font-display italic text-3xl">
	          <%= link_to(first_p.title, post_path(slug: first_p.slug), class: "hover:text-moss") %>
	        </h3>
	        <p class="text-muted leading-normal mb-4 max-w-md">
	          <%= first_p.preview %>
	        </p>

  			<div class="flex items-center justify-between">
  			  <div class="flex items-center">
  			    <img
  			      alt="post author <%= pretty_author(first_p.author) %>"
  			      src="<%= author_photo(first_p.author) %>"
  			      class="relative inline-block h-8 w-8 rounded-full"
  			    />
  			    <div class="flex flex-col ml-3 text-sm">
  			      <span class="text-ink font-medium"><%= pretty_author(first_p.author) %></span>
  			      <span class="text-muted text-xs">
  			        <%= first_p.published_on %>
  			      </span>
  			    </div>
  			  </div>
			  <%= link_to "Read →", post_path(slug: first_p.slug), class: "text-sm text-moss hover:text-moss-dark" %>
  		    </div>
	      </article>

		  <!-- post 2 -->
		  <% if second_p %>
		  <article data-post-id="<%= second_p.id %>">
	        <div class="rounded-2xl h-80 overflow-hidden mb-4">
	          <%= render 'shared/responsive_image',
	                     image_url: second_p.image,
	                     alt_text: second_p.title,
	                     css_classes: "object-cover object-center h-full w-full",
	                     link_url: "/post/#{second_p.slug}" %>
	        </div>
		    <div class="flex items-center gap-2 text-xs tracking-widest uppercase text-muted mb-2">
		      <i class="w-1.5 h-1.5 rounded-full <%= get_topic_color(second_p.topic.downcase) %>"></i><%= second_p.topic %>
		    </div>
	        <div class="flex flex-wrap">
	        <% if second_p.location.present? %>
		      <%= render "shared/post_locations", :post => second_p %>
	        <% end %>
	        <% if second_p.tags.present? %>
		      <%= render "shared/post_tags", :post => second_p %>
	        <% end %>
	        </div>
	        <h3 class="mb-2 font-display italic text-3xl">
	          <%= link_to(second_p.title, post_path(slug: second_p.slug), class: "hover:text-moss") %>
	        </h3>
	        <p class="text-muted leading-normal mb-4 max-w-md">
	          <%= second_p.preview %>
	        </p>

  		    <div class="flex items-center justify-between">
  		      <div class="flex items-center">
  		        <img
  		          alt="post author <%= pretty_author(second_p.author) %>"
  		          src="<%= author_photo(second_p.author) %>"
  		          class="relative inline-block h-8 w-8 rounded-full"
  		        />
  		        <div class="flex flex-col ml-3 text-sm">
  		          <span class="text-ink font-medium"><%= pretty_author(second_p.author) %></span>
  		          <span class="text-muted text-xs">
  		            <%= second_p.published_on %>
  		          </span>
  		        </div>
  		      </div>
			  <%= link_to "Read →", post_path(slug: second_p.slug), class: "text-sm text-moss hover:text-moss-dark" %>
  		    </div>
		  </article>
		  <% end %>

	    </div>
	  </div>
	</section>