<% @top12.sample(2).each do |post| %>
  <div class="font-sans text-ink hover:bg-air border-b border-line last:border-b-0">
    <a href="<%= post_path(slug: post.slug) %>">
      <div class="container px-4 py-3 mx-auto">
        <div class="flex sm:flex-row sm:items-center items-start">
          <div class="flex-shrink-0 mr-4">
            <%= render 'shared/responsive_image',
                       image_url: post.image,
                       alt_text: post.title,
                       css_classes: "w-20 h-20 object-cover rounded-xl",
                       loading: "lazy" %>
          </div>
          <div class="flex-grow">
            <h3 class="not-italic font-sans font-medium text-sm mb-1 text-ink"><%= post.title %></h3>
            <p class="text-muted text-xs leading-tight"><%= truncate(post.preview, length: 80) %></p>
          </div>
        </div>
      </div>
    </a>
  </div>
<% end %>