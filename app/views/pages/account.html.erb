	<div class="container mx-auto max-w-2xl px-5 py-12 font-sans text-ink">
  <% if Current.user %>
    <div class="bg-paper border border-line rounded-2xl p-6 mb-6">
      <h2 class="text-2xl font-display italic mb-4">Profile Information</h2>

      <div class="space-y-3">
        <% if Current.user.profile_image_url.present? %>
          <div class="flex justify-center mb-4">
            <img src="<%= Current.user.profile_image_url(size: 96) %>"
                 class="rounded-full w-24 h-24 object-cover"
                 alt="Profile picture"
                 referrerpolicy="no-referrer"
                 crossorigin="anonymous" />
          </div>
        <% end %>

        <% if Current.user.admin? %>
          <div class="flex justify-center mb-4">
            <span class="bg-sienna text-white px-4 py-1 rounded-full text-sm font-semibold">
              Admin
            </span>
          </div>
        <% end %>

        <div>
          <label class="text-muted text-sm">Email</label>
          <p class="text-ink font-medium"><%= Current.user.email_address %></p>
        </div>

        <% if Current.user.provider.present? %>
          <div>
            <label class="text-muted text-sm">Sign-in Method</label>
            <p class="text-ink font-medium"><%= Current.user.provider.capitalize %> OAuth</p>
          </div>
        <% end %>

        <div>
          <label class="text-muted text-sm">Account Status</label>
          <p class="text-ink font-medium">
            <% if Current.user.confirmed? %>
              <span class="text-moss">Confirmed</span>
            <% else %>
              <span class="text-clay">Pending Confirmation</span>
            <% end %>
          </p>
        </div>
      </div>
    </div>

    <div class="flex gap-4">
      <%= button_to "Sign Out", session_path, method: :delete, class: "px-6 py-2 border border-line text-ink rounded-full hover:border-moss hover:text-moss transition-colors" %>
    </div>
  <% else %>
    <div class="bg-paper border border-line rounded-2xl p-6">
      <p class="text-muted">You are not signed in.</p>
      <%= link_to "Sign In", pages_authentication_path, class: "inline-block mt-4 px-6 py-2 bg-moss text-white rounded-full hover:bg-moss-dark transition-colors" %>
    </div>
  <% end %>
</div>
