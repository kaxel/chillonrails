<section class="font-sans text-ink">
  <div class="container mx-auto flex flex-col px-5 py-4 justify-center items-center">
    <div class="w-full md:w-2/3 flex flex-col items-center text-center">
      <p class="mb-8 leading-relaxed text-muted">Browse all posts organized by month and year:</p>
    </div>

    <div class="w-full max-w-4xl">
      <% @posts_by_month.each do |month_key, posts| %>
        <% date = Date.strptime(month_key, "%Y-%m") %>
        <div class="mb-8">
          <h2 class="text-2xl not-italic font-sans font-medium text-ink mb-4 border-b border-line pb-2">
            <%= date.strftime("%B %Y") %>
          </h2>
          <div class="grid gap-2">
            <% posts.each do |post| %>
              <div class="hover:bg-paper p-2 rounded-lg">
                <%= link_to post_path(slug: post.slug), class: "flex items-center justify-between text-ink hover:text-moss" do %>
                  <div class="flex-grow">
                    <span class="text-lg"><%= post.title %></span>
                    <% if post.topic %>
                      <span class="ml-2 text-sm text-muted bg-air px-2 py-1 rounded-full">
                        <%= post.topic %>
                      </span>
                    <% end %>
                  </div>
                  <span class="text-sm text-muted ml-4">
                    <%= post.published_on.strftime("%B %d") %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @posts_by_month.empty? %>
        <div class="text-center py-8">
          <p class="text-muted">No published posts found.</p>
        </div>
      <% end %>

      <div class="text-center py-6 border-t border-line mt-8">
        <p class="text-sm text-muted">
          Total: <%= @posts_by_month.values.flatten.size %> records
        </p>
      </div>
    </div>
  </div>
</section>