<h1 class="font-display italic sm:text-4xl text-3xl mb-4 text-ink text-center">Editor-in-Chief
  <br class="hidden lg:inline-block">Krister Axel
</h1>
<section class="font-sans text-ink">
  <div class="container mx-auto flex px-5 py-12 md:flex-row flex-col items-center">
    <div class="lg:max-w-lg lg:w-full md:w-1/2 w-5/6 mb-10 md:mb-0">
      <%= image_tag "chillfiltr_hemp_parchment.png", class:"object-cover object-center rounded"  %>
    </div>
    <div class="lg:flex-grow md:w-1/2 lg:pl-24 md:pl-16 flex flex-col md:items-start md:text-left items-center text-center">
      
      <p class="mb-8 leading-relaxed">CHILLFILTR® was built for one simple reason: to bring a spotlight to independent artists & creators from around the world.</p>
	  <p class="leading-relaxed">You can use the contact form below. If you are sending me music, please use <%= link_to("this form", pages_submit_path, :class => "text-moss hover:text-moss-dark underline") %> instead.</p>
	  <div class="bg-paper border border-line rounded-2xl p-6 flex text-center justify-center">
		<form action="https://api.web3forms.com/submit" method="POST">

		    <!-- Replace with your Access Key -->
		    <input type="hidden" name="access_key" value="2822f03b-fe85-4f97-9c10-a316a6dd1f25">

		    <!-- Form Inputs. Each input must have a name="" attribute -->
			<div><small><label width="30">Name</label></small>
		    <input type="text" name="name" required class="bg-white m-2 float-right"></div>
			<div class="mt-4"><small><label width="30">Email</label></small>
		    <input type="email" name="email" required class="bg-white m-2 float-right"></div>
			<div class="mt-4"><small><label width="30">Message</label></small>
		    <textarea name="message" required class="bg-white m-2 float-right" cols=26></textarea></div>

		    <!-- Honeypot Spam Protection -->
		    <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

		    <!-- Custom Confirmation / Success Page -->
		    <!-- <input type="hidden" name="redirect" value="https://mywebsite.com/thanks.html"> -->
			<br/>	
		    <button type="submit" class="text-white bg-moss hover:bg-moss-dark rounded-full px-6 py-2 m-2">SEND MESSAGE</button>

		</form>
	  </div>
    </div>
  </div>
  <hr/>
</section>

<section class="font-sans text-ink mb-8">
  <div class="container mx-auto flex px-5 py-12 md:flex-row flex-col items-center">
    <div class="lg:max-w-lg lg:w-full md:w-1/2 w-5/6 mb-10 md:mb-0">
      <%= image_tag "chillfiltr-ai.png", class:"object-cover object-center rounded"  %>
    </div>
    <div class="lg:flex-grow md:w-1/2 lg:pl-24 md:pl-16 flex flex-col md:items-start md:text-left items-center text-center">
      <h1 class="font-display italic sm:text-4xl text-3xl mb-4 text-ink">Submissions
      </h1>
      <p class="mb-8 leading-relaxed">You may use <%= link_to("this form", pages_submit_path, :class => "text-moss hover:text-moss-dark underline") %> to submit music. Music that we like will be added to our radio channel and possibly broadcast on <a href="https://kskq.org" target="_blank" class="text-moss hover:text-moss-dark underline">KSKQ</a>.</p>
	  <p>Pricing: <%= link_to "$3 per file", pages_submit_path, :class => "text-moss hover:text-moss-dark underline" %>.</p>
    </div>
  </div>
  <hr/>
</section>

<figure class="max-w-screen-md mx-auto text-center">
    <svg class="w-10 h-10 mx-auto mb-3 text-line" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 14">
        <path d="M6 0H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4v1a3 3 0 0 1-3 3H2a1 1 0 0 0 0 2h1a5.006 5.006 0 0 0 5-5V2a2 2 0 0 0-2-2Zm10 0h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4v1a3 3 0 0 1-3 3h-1a1 1 0 0 0 0 2h1a5.006 5.006 0 0 0 5-5V2a2 2 0 0 0-2-2Z"/>
    </svg>
    <blockquote>
        <p class="text-2xl font-display italic text-ink">
			Ring the bells that still can ring<br/>
			Forget your perfect offering<br/>
			There is a crack, a crack in everything<br/>
			That's how the light gets in<br/>
        </p>
    </blockquote>
    <figcaption class="flex items-center justify-center mt-6 space-x-3 rtl:space-x-reverse">
        <div class="flex items-center divide-x-2 rtl:divide-x-reverse divide-line mb-12">
            <cite class="ps-3 text-sm text-muted not-italic font-sans">Leonard Cohen</cite>
        </div>
    </figcaption>
</figure>

