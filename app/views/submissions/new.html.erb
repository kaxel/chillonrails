<% content_for :title, "Submit Your Music — CHILLFILTR®" %>

<div class="mx-auto md:w-2/3 w-full py-10 font-sans text-ink">
  <h1 class="font-display italic text-4xl mb-2">Submit Your Music</h1>
  <p class="text-muted mb-6">
    Upload your track(s) and pay a small listening fee of
    <strong>$<%= sprintf("%.2f", Submission::PRICE_PER_SONG_CENTS / 100.0) %> per song</strong>.
    We listen to everything; the best tracks make our radio channel.
  </p>

  <% if @submission.errors.any? %>
    <div class="bg-red-50 text-red-500 font-medium p-4 rounded-lg mb-5">
      <h2 class="font-bold mb-3"><%= pluralize(@submission.errors.count, "error") %> prohibited your submission:</h2>
      <ul class="list-disc list-inside">
        <% @submission.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @submission, url: submissions_path, method: :post, local: true,
        data: { controller: "song-fields", turbo: false, song_fields_price_per_song_value: Submission::PRICE_PER_SONG_CENTS,
                action: "direct-uploads:start->song-fields#uploadStart direct-uploads:end->song-fields#uploadEnd direct-upload:error->song-fields#uploadError" } do |form| %>

    <div class="my-4">
      <%= form.label :contact_name, "Your name", class: "block font-medium mb-1" %>
      <%= form.text_field :contact_name, required: true, autocomplete: "name",
            class: "block shadow rounded-md border border-line outline-none px-3 py-2 w-full focus:border-moss" %>
    </div>

    <div class="my-4">
      <%= form.label :email, "Email", class: "block font-medium mb-1" %>
      <%= form.email_field :email, required: true, autocomplete: "email",
            class: "block shadow rounded-md border border-line outline-none px-3 py-2 w-full focus:border-moss" %>
    </div>

    <div class="my-4">
      <%= form.label :artist_name, "Artist / band name", class: "block font-medium mb-1" %>
      <%= form.text_field :artist_name, required: true,
            class: "block shadow rounded-md border border-line outline-none px-3 py-2 w-full focus:border-moss" %>
    </div>

    <h2 class="font-display italic text-2xl mt-8 mb-3">Songs</h2>

    <div data-song-fields-target="rows">
      <%= form.fields_for :submission_songs do |song_form| %>
        <div data-song-row class="border border-line rounded-2xl p-4 mb-4">
          <div class="mb-3">
            <%= song_form.label :title, "Song title", class: "block font-medium mb-1" %>
            <%= song_form.text_field :title, required: true,
                  class: "block shadow rounded-md border border-line outline-none px-3 py-2 w-full focus:border-moss" %>
          </div>
          <div class="mb-2">
            <%= song_form.label :audio, "Audio file", class: "block font-medium mb-1" %>
            <%= song_form.file_field :audio, required: true, direct_upload: true,
                  accept: "audio/*", data: { action: "change->song-fields#fileSelected" },
                  class: "block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-blue-50 file:text-blue-700" %>
          </div>
          <button type="button" data-action="song-fields#remove"
                  class="text-sm text-red-600 hover:underline">Remove</button>
        </div>
      <% end %>
    </div>

    <%# Template cloned by the Stimulus controller for each additional song. %>
    <template data-song-fields-target="template">
      <div data-song-row class="border border-line rounded-2xl p-4 mb-4">
        <div class="mb-3">
          <label class="block font-medium mb-1">Song title</label>
          <input type="text" name="submission[submission_songs_attributes][__INDEX__][title]" required
                 class="block shadow rounded-md border border-line outline-none px-3 py-2 w-full focus:border-moss">
        </div>
        <div class="mb-2">
          <label class="block font-medium mb-1">Audio file</label>
          <input type="file" name="submission[submission_songs_attributes][__INDEX__][audio]" required
                 accept="audio/*" data-direct-upload-url="<%= rails_direct_uploads_url %>"
                 data-action="change->song-fields#fileSelected"
                 class="block w-full text-sm text-muted file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-air file:text-moss">
        </div>
        <button type="button" data-action="song-fields#remove"
                class="text-sm text-red-600 hover:underline">Remove</button>
      </div>
    </template>

    <button type="button" data-action="song-fields#add"
            class="rounded-full py-2 px-4 border border-line font-medium cursor-pointer hover:border-moss hover:text-moss">
      + Add another song
    </button>

    <div class="mt-8 mb-4 text-lg">
      <span class="text-muted"><span data-song-fields-target="count">1</span> song(s) ×
        $<%= sprintf("%.2f", Submission::PRICE_PER_SONG_CENTS / 100.0) %> =</span>
      <strong class="text-2xl ml-1" data-song-fields-target="total">$0.00</strong>
    </div>

    <button type="submit" data-song-fields-target="submitButton"
            class="rounded-full py-3 px-5 bg-moss hover:bg-moss-dark text-white inline-flex items-center gap-2 font-medium cursor-pointer disabled:opacity-70 disabled:cursor-not-allowed">
      <svg data-song-fields-target="spinner" class="hidden animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span data-song-fields-target="submitLabel">Continue to payment</span>
    </button>
    <p class="text-sm text-muted mt-3">You'll be redirected to Stripe to complete payment securely.</p>
  <% end %>
</div>
